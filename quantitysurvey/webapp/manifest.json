{
  "_version": "1.48.0",
  "sap.app": {
    "id": "cic.org.quantitysurvey",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.27.0",
      "toolsId": "dbcb2626-8474-4993-8cbc-40517c088d9c"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZINVOICEMANAGE_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.22",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.comp": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cic.org.quantitysurvey.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "dataModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/mockdata/POHeaderSet.json"
      },
      "home": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/mockdata/home.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "cic.org.quantitysurvey.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false,
        "transition": "slide"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": "",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "RouteDetails",
          "pattern": "Details/{poNumber}",
          "target": [
            "TargetDetails"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "viewName": "Home",
          "viewId": "Home"
        },
        "TargetDetails": {
          "viewName": "Details",
          "viewId": "Details"
        }
      }
    },
    "rootView": {
      "viewName": "cic.org.quantitysurvey.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}