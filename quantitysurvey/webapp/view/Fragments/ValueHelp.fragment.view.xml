<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="valueHelpDialog"
        title="{i18n>Select}"
        class="sapUiPopupWithPadding"
        search="onSearchValueHelp"
        liveChange="onSearchValueHelp"
        confirm="onConfirmValueHelp"
        cancel="onCancelValueHelp"
        items="{/ValueHelpSet}">

        <StandardListItem
            title="{idNumber}"
            description="{idText}"
            info="{selectionParameter}" />
        <!--  description= "{= ${idText} + ' (' + ${selectionParameter} + ')' }" />  -->
    </SelectDialog>
</core:FragmentDefinition> 