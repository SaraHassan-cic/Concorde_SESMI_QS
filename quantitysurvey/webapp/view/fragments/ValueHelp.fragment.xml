<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="valueHelpDialog"
        title="{vhDialog>/title}"
        search=".onSearchValueHelp"
        liveChange=".onSearchValueHelp"
        confirm=".onConfirmValueHelp"
        cancel=".onCancelValueHelp"
        items="{vhDialog>/ValueHelpSet}">

        <StandardListItem
            title="{vhDialog>idNumber}"
            description="{vhDialog>idText}"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>